{
  "dashboard": "Benefit Services SLA/SLO Scorecard",
  "folder": "scorecard",
  "repo": "abhatia-gusto/BenServices-Advising-Onboarding",
  "branch": "main",
  "runner": "python3 run.py --through YYYY-MM   (materializes live, then builds team/PE/IC views)",
  "warehouse_timezone": "America/Denver",
  "connector_note": "PAT as token= with authenticator=PROGRAMMATIC_ACCESS_TOKEN and region=us-west-2 (NOT password=).",
  "window_rule": "Run wide (2024-01-01→today; MRR 2023-05-01→today) and bucket downstream by close/end month. Fiscal quarters May–Apr; a quarter cell = Σnumerator ÷ Σdenominator.",
  "sources": [
    {"id": "bo", "path": "queries/bo_grain_sla_v11.sql", "params": ["{{Date Range Start}}", "{{Date Range End}}", "{{record_type_filter}}"],
     "writes": "bo_sla_v11_clean.csv", "grain": "benefit order",
     "metrics": ["% BO meeting all OA status", "Benefit Order ≤30d (NP/Renewal)", "New Plan cancel (close month)", "Ful→OA ticket rate NP/Renewal", "OA→Advising ticket rate"]},
    {"id": "adv", "path": "queries/advising_opp_sla.sql", "params": ["{{date_start}}", "{{date_end}}"],
     "writes": "queries/advising_opp_data_latest.csv", "grain": "advising opportunity",
     "metrics": ["Advising RFD ≤5d", "ER Confirm ≤5d", "Alt Requested ≤5d"],
     "shared_with": "advising-performance/queries/opp_sla.sql"},
    {"id": "byb", "path": "queries/byb_bo_sla_v7.sql", "params": ["{{Date Range Start}}", "{{Date Range End}}"],
     "writes": "queries/byb_data_2024-01-01_to_<today>.csv", "grain": "BYB benefit order",
     "metrics": ["Ready Intro ≤3d", "Implementation ≤5d", "Transition ≤2d/stg", "BYB E2E ≤60d", "BYB cancel"]},
    {"id": "bt", "path": "queries/bt_bo_sla_v8.sql", "params": ["{{Date Range Start}}", "{{Date Range End}}"],
     "writes": "queries/bt_data_2024-01-01_to_<today>.csv", "grain": "BT benefit order",
     "metrics": ["Qualification ≤5d", "Implementation ≤5d", "Transition ≤2d/stg", "BT E2E ≤35d", "BT cancel"]},
    {"id": "mrr", "path": "queries/mrr_cohort.sql", "params": ["{{Close Start}}", "{{Close End}}"],
     "writes": "advising_mrr_cohort_<today>.csv", "grain": "resolved opp",
     "metrics": ["Advising Net MRR Retention % (percent only)"]},
    {"id": "csat", "path": "queries/csat.sql", "params": ["{{Date Start}}", "{{Date End}}"],
     "writes": "csat_data_2025-01-01_to_<today>.csv", "grain": "survey",
     "metrics": ["Renewal CSAT", "New Benefits CSAT", "BYB CSAT", "BT CSAT"],
     "shared_with": "advising-performance/queries/csat.sql"},
    {"id": "inapp", "path": "queries/inapp.sql", "params": ["{{survey_start_date}}", "{{survey_end_date}}", "{{workflow_status}}"],
     "writes": "inapp_data_2025-01-01_to_<today>.csv", "grain": "survey",
     "metrics": ["In-App Sentiment"], "shared_with": "advising-performance/queries/inapp.sql"},
    {"id": "avail", "path": "queries/av_pit.sql + queries/calls_pit.sql", "params": [],
     "writes": "_data_v2/av_pit.csv, _data_v2/calls_pit.csv", "grain": "team×IC×day",
     "metrics": ["Phone availability (70–105 BYB/BT, 80–105 else)", "Phone abandon ≤30%"],
     "note": "av_pit SLA uses a 70 floor for BYB/BT (canonical availability.sql hardcodes 80 and is wrong there)."},
    {"id": "roster", "path": "queries/roster_calls.sql + queries/roster_npr.sql", "params": [],
     "writes": "_data_v2/roster_calls.csv, oa_dash/data/roster.json", "grain": "employee",
     "metrics": ["(resolver) maps phone/email at PE and IC grain to current PE/leader"]},
    {"id": "email", "path": "queries/email_sla_attp.sql", "params": ["{{ TP Date Range Start }}", "{{ TP Date Range End }}"],
     "writes": "email-sla-dashboard-v10.html (gzip+base64 embed id=__EMBED__)", "grain": "email touchpoint",
     "metrics": ["Email SLO ≤4h, split by responding owner's team"]},
    {"id": "ticket", "path": "queries/ticket_sla_v12.sql", "params": ["{{Date Range Start}}", "{{Date Range End}}"],
     "writes": "ticket_sla_by_flow_v12.html (plain CSV embed id=__EMBED__)", "grain": "ticket",
     "metrics": ["Ful→OA Ticket SLA ≤5d", "OA→Advising Ticket SLA ≤5d"],
     "note": "Derives HAS_OA_TOUCH via SCD2 point-in-time on bi.gusto_employees; extracted verbatim from pull_v12_attribution_data.py."},
    {"id": "ready", "path": "queries/operating_metrics_difot.sql", "params": [],
     "writes": "benservices_operating_metrics_dashboard_v1.html (plain CSV embed id=embeddedData)", "grain": "cohort month×record type",
     "metrics": ["Ready by 1st — next cohort (Renewal)", "New Plan cohort cancel chart"],
     "note": "Scorecard calendar month M shows cohort M+1 for Ready-by-1st."}
  ],
  "lib": [
    "lib/scorecard_compute.py (shared helpers + metric defs)",
    "lib/scorecard_team_compute.py + scorecard_team_render.py + scorecard_cancel_render.py (TEAM view)",
    "lib/scorecard_pe2_compute.py + scorecard_pe2_render.py + scorecard_pe2_sidebyside.py (PE/team-lead view)",
    "lib/scorecard_ic_compute.py + scorecard_ic_sidebyside.py (IC view)",
    "lib/scorecard_team_widget.template.html (team widget shell)",
    "lib/new_hire_default_off.json (IC ** recent-hire flag source of truth)"
  ]
}
